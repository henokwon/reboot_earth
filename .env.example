EARTH_ENGINE_PROJECT=your-google-cloud-project-id
EARTH_ENGINE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account@example.iam.gserviceaccount.com
# Use a NEW key after revoking the exposed credential. Keep this server-side.
# Store multiline private keys with escaped newlines (\n) in local environment files.
EARTH_ENGINE_SERVICE_ACCOUNT_PRIVATE_KEY=replace-with-a-new-service-account-private-key
